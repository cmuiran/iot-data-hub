# Copy to deploy/.env (gitignored) and fill in. Placeholders only: never commit real values.
PUBLIC_HOST=hub.example.com
DB_PASSWORD=
EMQX_DASHBOARD_PASSWORD=
# at least 24 characters; the same value is given to EMQX (hooks) and the hub
HUB_BROKER_HOOK_TOKEN=
# hub settings (see the repository's .env.example for the full list)
HUB_JWT_SECRET=
HUB_DATA_KEY=
HUB_PUBLIC_URL=https://hub.example.com/app
HUB_CONTROL_ENABLED=true
HUB_SIGNUP_ENABLED=false
HUB_TLS_CERT=/srv/hub/certs/server.crt
HUB_TLS_KEY=/srv/hub/certs/server.key
HUB_SMTP_HOST=
HUB_SMTP_USERNAME=
HUB_SMTP_PASSWORD=
HUB_MAIL_FROM=no-reply@hub.example.com
# the platform broker account of the hub (also in config/brokers.yaml as username_env/password_env)
HUB_PLATFORM_MQTT_USERNAME=
HUB_PLATFORM_MQTT_PASSWORD=
