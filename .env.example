# Copy to .env (gitignored) and fill in real values. Never commit .env.
# Real environment variables override this file.

# --- backend (hub-api) ----------------------------------------------------------------------
# PostgreSQL 14+ (TimescaleDB recommended for production). The hub applies migrations itself.
HUB_DATABASE_URL=postgresql://hub_app:changeme@localhost:5432/hub
# auto = use TimescaleDB if the extension is installed; on = require it; off = plain PostgreSQL
HUB_DB_TIMESCALE=auto
# Secret for signing access tokens: at least 32 random characters. Changing it logs everyone out.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
HUB_JWT_SECRET=changeme-generate-a-long-random-secret-here
HUB_CONFIG_DIR=config
HUB_HOST=127.0.0.1
HUB_PORT=8000
# Writes to devices are refused unless this is true (plus RBAC, read_write tags, control.yaml).
HUB_CONTROL_ENABLED=false
HUB_ACCESS_TOKEN_MINUTES=15
HUB_REFRESH_TOKEN_HOURS=12
HUB_LOGIN_MAX_FAILURES=5
HUB_LOCKOUT_MINUTES=15
HUB_PASSWORD_MIN_LENGTH=10
HUB_PENDING_WRITE_MINUTES=5
# Comma-separated origins of the web dashboard if it is served from another host/port.
HUB_CORS_ORIGINS=
# Interactive API docs (/api/docs) and the OpenAPI schema, readable without sign-in.
# Off in production (they map the whole API); hub-api --dev turns them on.
HUB_API_DOCS=false
# The web dashboard served at / (unset = the bundled frontend/, "off" = API only)
HUB_FRONTEND_DIR=

# --- security (see docs/backend.md section 15) ------------------------------------------------
# Encrypts TOTP secrets and backups. >= 32 random characters, keep a copy in a password safe:
# without it encrypted backups cannot be restored and MFA must be reset for everyone.
HUB_DATA_KEY=
# HTTPS directly from hub-api (hub-admin make-tls-cert, or a certificate from the company CA)
HUB_TLS_CERT=
HUB_TLS_KEY=
# Roles that must use two-factor authentication, e.g. admin,engineer,operator
HUB_MFA_REQUIRED_ROLES=admin,engineer
HUB_SESSION_IDLE_MINUTES=30
HUB_PASSWORD_MAX_AGE_DAYS=0
HUB_PASSWORD_HISTORY=3
# Requests per client address and minute (API, WebSocket handshake, /metrics)
HUB_RATE_LIMIT_PER_MIN=600
# Only these client networks may use the API (empty = any), e.g. 10.0.0.0/8,192.168.10.0/24
HUB_ALLOWED_NETWORKS=
# Browser origins allowed to open the live WebSocket (the hub's own host is always allowed)
HUB_ALLOWED_ORIGINS=
# Raise a system alarm when a certificate expires within this many days
HUB_CERT_WARN_DAYS=30
# Failed logins per client address within the window -> HTTP 429 (on top of the per-user lockout)
HUB_LOGIN_IP_MAX_FAILURES=20
HUB_LOGIN_IP_WINDOW_S=300
# Plant time zone: daily/monthly reports, hourly roll-up, backup time, schedules
HUB_TIMEZONE=Asia/Tehran

# --- storage housekeeping ---------------------------------------------------------------------
HUB_RETENTION_RAW_DAYS=365
HUB_RETENTION_HOURLY_DAYS=3650
# Daily pg_dump backup when set (folder), at HUB_BACKUP_TIME local time; keep the newest N files
HUB_BACKUP_DIR=
HUB_BACKUP_TIME=02:30
HUB_BACKUP_KEEP=14
# Full path of pg_dump.exe if it is not on PATH
HUB_PG_DUMP=

# --- OPC UA server output (SCADA reads the hub) -----------------------------------------------
HUB_OPCUA_SERVER=false
HUB_OPCUA_SERVER_HOST=127.0.0.1
HUB_OPCUA_SERVER_PORT=4840
# Writes from OPC UA clients go through the control-safety layer; off by default
HUB_OPCUA_SERVER_WRITES=false
# Allow an unencrypted endpoint (lab only)
HUB_OPCUA_SERVER_ALLOW_INSECURE=false
# Certificates: <pki>/hub-server.der/.pem (created on start), <pki>/trusted/ = allowed clients
HUB_PKI_DIR=pki

# --- monitoring, high availability, logging ---------------------------------------------------
# Enables GET /metrics (Prometheus) for scrapes with "Authorization: Bearer <token>" (>= 16 chars)
HUB_METRICS_TOKEN=
# on = two nodes share the database; one is active, the other standby (see docs/backend.md)
HUB_HA=off
HUB_NODE_ID=
# Rotating log file (in addition to the console)
HUB_LOG_FILE=
HUB_LOG_MAX_MB=20
HUB_LOG_BACKUPS=10

# --- device credentials (referenced by name from config/) -----------------------------------
HUB_MQTT_PLANT_USERNAME=changeme
HUB_MQTT_PLANT_PASSWORD=changeme
HUB_OPCUA_CLIENT_CERT_PATH=/path/to/hub-client-cert.der
HUB_OPCUA_CLIENT_KEY_PATH=/path/to/hub-client-key.pem
HUB_OPCUA_PLC01_USERNAME=changeme
HUB_OPCUA_PLC01_PASSWORD=changeme

# --- notification channels (referenced from config/notifications.yaml) ------------------------
HUB_SMTP_USERNAME=changeme
HUB_SMTP_PASSWORD=changeme
HUB_TELEGRAM_BOT_TOKEN=changeme
HUB_SMS_API_KEY=changeme
HUB_WEBHOOK_SECRET=changeme

# --- phase 3 devices and outputs (names used by the sample config; see docs/backend.md 16-19) -----
# Siemens S7 needs no credentials (PUT/GET access is set in the PLC).
# HTTP device inverter_01: API key and the plant CA that signed its certificate (file path)
HUB_INVERTER01_API_KEY=
HUB_INVERTER01_CA_FILE=
# SNMPv3 user of ups_01 (at least 8 characters each)
HUB_UPS01_AUTH_KEY=
HUB_UPS01_PRIV_KEY=
# MQTT over TLS: file paths of the plant CA and of the hub's client certificate/key, referenced
# from brokers.yaml (ca_file_env, client_certificate_env, client_private_key_env)
HUB_MQTT_CA_FILE=
HUB_MQTT_CLIENT_CERT=
HUB_MQTT_CLIENT_KEY=

# --- operations (phase 4, docs/backend.md sections 20-24) -------------------------------------
# JSON lines in HUB_LOG_FILE for log shippers (text = classic lines)
HUB_LOG_FORMAT=text
# Copy of every log record (and every audit row) to a syslog server / SIEM: udp://host:514 or tcp://host:601
HUB_SYSLOG=
HUB_SYSLOG_FACILITY=local0
# Self-monitoring
HUB_HEALTH_INTERVAL_S=30
HUB_DISK_WARN_PERCENT=10
HUB_DISK_CRITICAL_PERCENT=5
HUB_CLOCK_MAX_SKEW_S=30
# Compare the clock with an NTP server as well (host or host:port), e.g. the domain controller
HUB_NTP_SERVER=
HUB_BACKUP_MAX_AGE_HOURS=26
# Check every backup: off | archive (read it back) | full (restore into a temporary database; needs CREATEDB)
HUB_RESTORE_TEST=archive
HUB_RESTORE_TEST_DAYS=7

# --- Active Directory / LDAP sign-in (config/ldap.yaml, docs/backend.md section 27) -------------
# Password of the read-only service account named in ldap.yaml (bind_dn)
HUB_LDAP_BIND_PASSWORD=
# Path of the company CA certificate (PEM) that signed the domain controllers' certificates
HUB_LDAP_CA_FILE=

# --- Store & forward (docs/backend.md section 28) -----------------------------------------------
# Folder for data that cannot be delivered yet (database or northbound broker unreachable).
# Survives restarts; "off" disables it (the memory buffer then drops the oldest when full).
HUB_SPOOL_DIR=spool
# Size limit of the sample spool; the oldest batches are dropped beyond it
HUB_SPOOL_MAX_MB=1024

# --- Kafka output (northbound.yaml kafka:, docs/backend.md section 29) --------------------------
HUB_KAFKA_USERNAME=
HUB_KAFKA_PASSWORD=
# Path of the CA certificate (PEM) that signed the Kafka brokers' certificates
HUB_KAFKA_CA_FILE=

# --- Self-service accounts (platform phase 2) ----------------------------------------------
# Public sign-up with e-mail (invitations work even when it is off).
HUB_SIGNUP_ENABLED=false
# Base address of the links in e-mails (verification, password reset, invitations).
HUB_PUBLIC_URL=https://hub.example.com
# Outgoing mail; without HUB_SMTP_HOST no e-mail is sent (the server log says so).
HUB_SMTP_HOST=
HUB_SMTP_PORT=587
HUB_SMTP_SECURITY=starttls
# sign-in: HUB_SMTP_USERNAME / HUB_SMTP_PASSWORD above (shared with the notifications)
HUB_MAIL_FROM=no-reply@hub.example.com
HUB_VERIFY_HOURS=48
HUB_RESET_MINUTES=60
HUB_INVITATION_DAYS=7
HUB_ACCOUNT_IP_PER_HOUR=20
HUB_ACCOUNT_EMAIL_PER_HOUR=3

# --- Platform device contract (platform phase 4, docs/platform.md) ---------------------------
# TCP listener for devices (newline-delimited JSON over TLS with HUB_TLS_CERT / HUB_TLS_KEY).
HUB_TCP_INGEST_PORT=
HUB_TCP_INGEST_HOST=0.0.0.0
# Plain TCP without TLS: development only.
HUB_TCP_INGEST_INSECURE=false
# broker_id (brokers.yaml) where native devices publish d/<device_id>/telemetry etc.
HUB_PLATFORM_BROKER=
HUB_PLATFORM_TOPIC_PREFIX=
# Shared subscription group when several hub nodes read the same broker.
HUB_PLATFORM_SHARED_GROUP=
# Token the broker's HTTP auth/ACL hooks send (X-Hub-Hook-Token), at least 24 characters.
HUB_BROKER_HOOK_TOKEN=
