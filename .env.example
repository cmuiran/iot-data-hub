# Copy to .env (gitignored) and fill in real values. Never commit .env.
# Real environment variables override this file.

# --- backend (hub-api) ----------------------------------------------------------------------
# PostgreSQL 14+ (TimescaleDB recommended for production). The hub applies migrations itself.
HUB_DATABASE_URL=postgresql://hub_app:changeme@localhost:5432/hub
# auto = use TimescaleDB if the extension is installed; on = require it; off = plain PostgreSQL
HUB_DB_TIMESCALE=auto
# Secret for signing access tokens: at least 32 random characters. Changing it logs everyone out.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
HUB_JWT_SECRET=changeme-generate-a-long-random-secret-here
HUB_CONFIG_DIR=config
HUB_HOST=127.0.0.1
HUB_PORT=8000
# Writes to devices are refused unless this is true (plus RBAC, read_write tags, control.yaml).
HUB_CONTROL_ENABLED=false
HUB_ACCESS_TOKEN_MINUTES=15
HUB_REFRESH_TOKEN_HOURS=12
HUB_LOGIN_MAX_FAILURES=5
HUB_LOCKOUT_MINUTES=15
HUB_PASSWORD_MIN_LENGTH=10
HUB_PENDING_WRITE_MINUTES=5
# Comma-separated origins of the web dashboard if it is served from another host/port.
HUB_CORS_ORIGINS=
# Failed logins per client address within the window -> HTTP 429 (on top of the per-user lockout)
HUB_LOGIN_IP_MAX_FAILURES=20
HUB_LOGIN_IP_WINDOW_S=300
# Plant time zone: daily/monthly reports, hourly roll-up, backup time, schedules
HUB_TIMEZONE=Asia/Tehran

# --- storage housekeeping ---------------------------------------------------------------------
HUB_RETENTION_RAW_DAYS=365
HUB_RETENTION_HOURLY_DAYS=3650
# Daily pg_dump backup when set (folder), at HUB_BACKUP_TIME local time; keep the newest N files
HUB_BACKUP_DIR=
HUB_BACKUP_TIME=02:30
HUB_BACKUP_KEEP=14
# Full path of pg_dump.exe if it is not on PATH
HUB_PG_DUMP=

# --- OPC UA server output (SCADA reads the hub) -----------------------------------------------
HUB_OPCUA_SERVER=false
HUB_OPCUA_SERVER_HOST=127.0.0.1
HUB_OPCUA_SERVER_PORT=4840
# Writes from OPC UA clients go through the control-safety layer; off by default
HUB_OPCUA_SERVER_WRITES=false
# Allow an unencrypted endpoint (lab only)
HUB_OPCUA_SERVER_ALLOW_INSECURE=false
# Certificates: <pki>/hub-server.der/.pem (created on start), <pki>/trusted/ = allowed clients
HUB_PKI_DIR=pki

# --- monitoring, high availability, logging ---------------------------------------------------
# Enables GET /metrics (Prometheus) for scrapes with "Authorization: Bearer <token>" (>= 16 chars)
HUB_METRICS_TOKEN=
# on = two nodes share the database; one is active, the other standby (see docs/backend.md)
HUB_HA=off
HUB_NODE_ID=
# Rotating log file (in addition to the console)
HUB_LOG_FILE=
HUB_LOG_MAX_MB=20
HUB_LOG_BACKUPS=10

# --- device credentials (referenced by name from config/) -----------------------------------
HUB_MQTT_PLANT_USERNAME=changeme
HUB_MQTT_PLANT_PASSWORD=changeme
HUB_OPCUA_CLIENT_CERT_PATH=/path/to/hub-client-cert.der
HUB_OPCUA_CLIENT_KEY_PATH=/path/to/hub-client-key.pem
HUB_OPCUA_PLC01_USERNAME=changeme
HUB_OPCUA_PLC01_PASSWORD=changeme

# --- notification channels (referenced from config/notifications.yaml) ------------------------
HUB_SMTP_USERNAME=changeme
HUB_SMTP_PASSWORD=changeme
HUB_TELEGRAM_BOT_TOKEN=changeme
HUB_SMS_API_KEY=changeme
HUB_WEBHOOK_SECRET=changeme
