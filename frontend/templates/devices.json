{
  "modbus_tcp": {
    "device_id": "new_meter_01",
    "name": "New Modbus meter",
    "site": "kish",
    "area": "substation",
    "protocol": "modbus_tcp",
    "enabled": false,
    "poll_interval_ms": 1000,
    "connection": {
      "host": "192.168.10.30",
      "port": 502,
      "unit_id": 1,
      "timeout_ms": 1000,
      "retries": 3,
      "byte_order": "big",
      "word_order": "big"
    },
    "tags": [
      {
        "name": "voltage_l1",
        "unit": "V",
        "data_type": "float32",
        "register_type": "input",
        "address": 0
      }
    ]
  },
  "modbus_rtu": {
    "device_id": "new_rtu_01",
    "name": "New Modbus RTU device",
    "site": "kish",
    "area": "substation",
    "protocol": "modbus_rtu",
    "enabled": false,
    "poll_interval_ms": 1000,
    "connection": {
      "port": "COM3",
      "baudrate": 9600,
      "parity": "N",
      "stopbits": 1,
      "unit_id": 1
    },
    "tags": [
      {
        "name": "temperature",
        "unit": "degC",
        "data_type": "int16",
        "register_type": "holding",
        "address": 0,
        "scale": 0.1
      }
    ]
  },
  "mqtt": {
    "device_id": "new_sensor_01",
    "name": "New MQTT sensor",
    "site": "kish",
    "area": "warehouse",
    "protocol": "mqtt",
    "enabled": false,
    "connection": {
      "broker_ref": "plant_broker",
      "telemetry_topic": "kish/warehouse/new_sensor_01/telemetry",
      "payload_format": "json",
      "qos": 1
    },
    "tags": [
      {
        "name": "temperature",
        "unit": "degC",
        "data_type": "float32",
        "json_path": "$.temp"
      }
    ]
  },
  "opcua": {
    "device_id": "new_plc_01",
    "name": "New OPC UA PLC",
    "site": "kish",
    "area": "pump_station",
    "protocol": "opcua",
    "enabled": false,
    "connection": {
      "endpoint_url": "opc.tcp://192.168.10.50:4840",
      "security_policy": "None",
      "security_mode": "None"
    },
    "tags": [
      {
        "name": "motor_speed",
        "unit": "rpm",
        "data_type": "float32",
        "node_id": "ns=2;s=Pump.MotorSpeed"
      }
    ]
  },
  "s7": {
    "device_id": "new_s7_plc_01",
    "name": "New S7 PLC",
    "site": "kish",
    "area": "pump_station",
    "protocol": "s7",
    "enabled": false,
    "poll_interval_ms": 1000,
    "connection": {
      "host": "192.168.10.60",
      "port": 102,
      "rack": 0,
      "slot": 1
    },
    "tags": [
      {
        "name": "flow",
        "unit": "m3/h",
        "data_type": "float32",
        "address": "DB1.DBD0"
      },
      {
        "name": "pump_running",
        "data_type": "bool",
        "address": "DB1.DBX4.0"
      }
    ]
  },
  "http": {
    "device_id": "new_http_01",
    "name": "New HTTP device",
    "site": "kish",
    "area": "solar_roof",
    "protocol": "http",
    "enabled": false,
    "poll_interval_ms": 5000,
    "connection": {
      "base_url": "https://192.168.10.70",
      "auth": {
        "type": "bearer",
        "token_env": "HUB_NEW_HTTP01_TOKEN"
      }
    },
    "tags": [
      {
        "name": "power",
        "unit": "kW",
        "data_type": "float32",
        "path": "/api/status",
        "json_path": "$.power"
      }
    ]
  },
  "snmp": {
    "device_id": "new_ups_01",
    "name": "New SNMP device",
    "site": "kish",
    "area": "server_room",
    "protocol": "snmp",
    "enabled": false,
    "poll_interval_ms": 10000,
    "connection": {
      "host": "192.168.10.80",
      "security": {
        "version": "3",
        "username": "hubmon",
        "auth_protocol": "sha256",
        "auth_key_env": "HUB_NEW_UPS01_AUTH_KEY",
        "priv_protocol": "aes128",
        "priv_key_env": "HUB_NEW_UPS01_PRIV_KEY"
      }
    },
    "tags": [
      {
        "name": "battery_charge",
        "unit": "%",
        "data_type": "uint16",
        "oid": "1.3.6.1.2.1.33.1.2.4.0",
        "min": 0,
        "max": 100
      }
    ]
  }
}
