{
  "modbus_tcp": {
    "device_id": "new_meter_01",
    "name": "New Modbus meter",
    "site": "kish",
    "area": "substation",
    "protocol": "modbus_tcp",
    "enabled": false,
    "poll_interval_ms": 1000,
    "connection": {
      "host": "192.168.10.30",
      "port": 502,
      "unit_id": 1,
      "timeout_ms": 1000,
      "retries": 3,
      "byte_order": "big",
      "word_order": "big"
    },
    "tags": [
      {
        "name": "voltage_l1",
        "unit": "V",
        "data_type": "float32",
        "register_type": "input",
        "address": 0
      }
    ]
  },
  "modbus_rtu": {
    "device_id": "new_rtu_01",
    "name": "New Modbus RTU device",
