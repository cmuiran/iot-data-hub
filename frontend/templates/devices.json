    "protocol": "modbus_rtu",
    "enabled": false,
    "poll_interval_ms": 1000,
    "connection": {
      "port": "COM3",
      "baudrate": 9600,
      "parity": "N",
      "stopbits": 1,
      "unit_id": 1
    },
    "tags": [
      {
        "name": "temperature",
        "unit": "degC",
        "data_type": "int16",
        "register_type": "holding",
        "address": 0,
        "scale": 0.1
      }
    ]
  },
