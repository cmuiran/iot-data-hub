.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.tox/

# Frontend
node_modules/
frontend/dist/
frontend/build/

# Data / logs
*.log
logs/
*.sqlite3
data/db/

